<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-batch-metadata-mas" author="dcre">
        <!-- SCRUM-107 (MAF->MAS rename): the id and the sqlFile path both changed, and
             maf_databasechangelog was renamed to mas_databasechangelog, so against any
             database migrated under the old names this changeset is NEW and would re-run
             its CREATE TABLEs. Every other changeset in this service is already MARK_RAN
             guarded; this one was the sole unguarded changeset. -->
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="MAS_BATCH_JOB_INSTANCE"/>
            </not>
        </preConditions>
        <!-- LIQUIBASE-SQL-EXCEPTION: the Spring Batch 6.0.4 metadata schema is the
             framework's own autogenerated DDL (MAS_BATCH_ prefixed, EXIT_MESSAGE
             widened to TEXT for CockroachDB); it is shipped verbatim as an external
             .sql and cannot be re-expressed as typed Liquibase tags. Same pattern as
             every DCRE stage service (crr/ctv/mrr/mrv batch-metadata-<svc>.sql). -->
        <sqlFile path="db/changelog/2026/07/batch-metadata-mas.sql" splitStatements="true"/>
    </changeSet>

</databaseChangeLog>
