<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- man_affordability_enquiry: MAS single writer (R-04, R-08). The write-ahead
         enquiry ledger. One intent row per scored instruction record, persisted
         BEFORE the (billed) bureau call so a crash between persist and call leaves
         a durable marker: on resume the READY scan re-picks the SCORE_PENDING spine
         row and the DETERMINISTIC intent_key re-issues the IDENTICAL bureau request
         (exactly-one enquiry). Two independent UNIQUE keys both make the intent row
         first-write-wins on the FULL business identity, so the guarded INSERT ...
         ON CONFLICT DO NOTHING is a zero-duplicate no-op on resume (never UPSERT on
         the PK; CRDB resolves UPSERT on PK only, persistence.md):
           * uq_man_afford_entry (arrival_id, sequence) = the entry FK identity,
           * uq_man_afford_intent_key (intent_key)      = the DCRE-minted key.
         outcome carries the platform-model MandateOutcome name (R-21: code values,
         never enum ordinals): PASS / FAIL_SCORE_BELOW_THRESHOLD while settled,
         HOLD_BUREAU_UNAVAILABLE while carried over (R-12). completed_at is NULL
         until the bureau call settles, so an unsettled (crashed or carried) intent
         is distinguishable from a decided one. Score is NULL until decided.
         MAS reads the mrr-owned spine (mandate_request_entry) and OWNS this table
         and the spine_state VALIDATED -> SCORE_PENDING -> SCORE_PASSED|SCORE_DECLINED
         transitions (ruling note 2). -->
    <changeSet id="mas-001-man-affordability-enquiry" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="man_affordability_enquiry"/></not>
        </preConditions>
        <createTable tableName="man_affordability_enquiry">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- FK-shaped to mandate_request_entry (arrival_id, sequence); app-side. -->
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="sequence" type="INT"><constraints nullable="false"/></column>
            <column name="intent_key" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_man_afford_intent_key"/>
            </column>
            <column name="requested_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(32)"/>
            <column name="score" type="INT"/>
            <column name="completed_at" type="TIMESTAMPTZ"/>
        </createTable>
        <addUniqueConstraint tableName="man_affordability_enquiry" columnNames="arrival_id, sequence"
                             constraintName="uq_man_afford_entry"/>
    </changeSet>

</databaseChangeLog>
